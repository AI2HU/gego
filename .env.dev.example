# Copy to .env.dev and adjust for local development:
#   cp .env.dev.example .env.dev
#
# Loaded automatically by Makefile dev targets (dev, dev-api, dev-worker).

API_PORT=8989
UI_PORT=5173
GEGO_JWT_SECRET=change-me-to-a-secret-at-least-32-chars
GEGO_BOOTSTRAP_ADMIN_PASSWORD=admin1234
GEGO_BOOTSTRAP_ADMIN_USERNAME=admin
GEGO_ETCD_ENDPOINTS=127.0.0.1:2379
GEGO_POSTGRES_URI=postgres://localhost:5432/gego?sslmode=disable
GEGO_MONGODB_URI=mongodb://localhost:27017
GEGO_MONGODB_DATABASE=gego
GEGO_FIXTURES=dev
