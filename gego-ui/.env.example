# Gego UI environment variables
# Copy to .env.local for local overrides (gitignored by default).

# API base URL for fetch requests.
# Local dev: leave unset — Vite proxies /api to http://localhost:8989 (see vite.config.ts).
# Production: set to your Gego API, e.g. https://api.example.com/api/v1
# VITE_API_BASE_URL=/api/v1
